{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "app.js",
        "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
      },
      {
        "source": "index.html",
        "headers": [{"key":"Cache-Control","value":"no-store, max-age=0"}]
      }
    ]
  },
  "firestore": {"rules": "firestore.rules"}
}
